{
  "name": "storeseeker",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w @storeseeker/api",
    "dev:web": "npm run dev -w @storeseeker/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
