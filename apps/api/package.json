{
  "name": "@storeseeker/api",
  "version": "0.2.0",
  "main": "dist/server.js",
  "scripts": {
    "pretest": "npm run build -w @storeseeker/shared",
    "test": "node ../../scripts/vitest.mjs run --project unit",
    "prebuild": "npm run build -w @storeseeker/shared",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "predev": "npm run build -w @storeseeker/shared",
    "dev": "tsx watch src/server.ts",
    "pretypecheck": "npm run build -w @storeseeker/shared",
    "typecheck": "tsc --noEmit",
    "pretest:integration": "npm run build -w @storeseeker/shared",
    "test:integration": "node ../../scripts/vitest.mjs run --project integration",
    "prestore:set": "npm run build -w @storeseeker/shared",
    "store:set": "tsx src/scripts/set-store.ts",
    "preseed": "npm run build -w @storeseeker/shared",
    "seed": "tsx src/scripts/seed.ts",
    "prescrape:live-check": "npm run build -w @storeseeker/shared",
    "scrape:live-check": "tsx src/scripts/live-check.ts",
    "preworker": "npm run build -w @storeseeker/shared",
    "worker": "tsx src/worker.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@storeseeker/shared": "*",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.10",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "puppeteer": "^25.18.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "rimraf": "^6.1.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "description": "",
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.13"
    }
  }
}
