# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
# MongoDB connection string, e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/storeseeker
# URL-encode special characters in the password (@ becomes %40, : becomes %3A).
MONGODB_URI=
CLIENT_URL=http://localhost:5173
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
# Optional: database name that overrides the one in MONGODB_URI.
# Set to storeseeker-demo (filled by npm run seed) to serve the made-up demo data.
MONGODB_DB_NAME=
